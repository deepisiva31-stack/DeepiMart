# ===== DeepiMart environment variables =====
# Copy this file to .env for local development:
#   cp .env.example .env
# On Render/Hosted platforms set these in the dashboard instead (do not commit real secrets).

# Port the HTTP server listens on. Render sets this automatically.
PORT=3000

# Production mode (turns on stricter/smaller responses). Render sets NODE_ENV=production automatically.
NODE_ENV=development

# ----- SQLite database (REQUIRED for persistence on Render) -----
# Local default: ./data/deepimart.db (created inside the project folder).
# On Render point this at the mounted persistent Disk so data survives restarts/redeploys, e.g.:
#   DB_PATH=/opt/render/project/src/data/deepimart.db
DB_PATH=./data/deepimart.db

# ----- Uploaded images (REQUIRED for persistence on Render) -----
# Local default: ./uploads (inside the project folder).
# On Render point this at the mounted persistent Disk, e.g.:
#   UPLOADS_DIR=/opt/render/project/src/uploads
UPLOADS_DIR=./uploads

# ----- CORS -----
# Comma-separated list of allowed origins for browser API calls.
# Leave unset to reflect any origin (fine for a same-origin SPA). Example:
#   CORS_ORIGIN=https://deepimart.onrender.com,http://localhost:3000
# CORS_ORIGIN=

# ----- Admin self-service account creation -----
# Secret code an admin types on the "Create New Admin" form. Validated on the
# server only and NEVER sent to the browser. REQUIRED for that feature.
ADMIN_SETUP_CODE=replace-with-a-strong-random-code

# ----- Seeding -----
# Set to 1 to SKIP the idempotent demo seed on startup (keeps production data untouched).
# Default (unset/0): seed runs but never deletes or overwrites existing data.
# DISABLE_SEED=1